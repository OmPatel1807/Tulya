{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p dist && cp -r frontend/* dist/",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/api/:path*", "destination": "https://tulya.onrender.com/api/:path*" },
    { "source": "/samples/:path*", "destination": "https://tulya.onrender.com/samples/:path*" },
    { "source": "/health", "destination": "https://tulya.onrender.com/health" }
  ]
}
