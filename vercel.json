{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/app",
      "destination": "/frontend/app.html"
    },
    {
      "source": "/static/:path*",
      "destination": "/frontend/static/:path*"
    },
    {
      "source": "/public/:path*",
      "destination": "/frontend/public/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tulya.onrender.com/api/:path*"
    },
    {
      "source": "/samples/:path*",
      "destination": "https://tulya.onrender.com/samples/:path*"
    },
    {
      "source": "/health",
      "destination": "https://tulya.onrender.com/health"
    }
  ]
}
