# =====================================================================
# Tulya (तुल्य) - Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# Server & Runtime Configuration
# ---------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
PYTHON_VERSION=3.11.9

# ---------------------------------------------------------------------
# LLM Provider Configuration (Optional)
# Used for grounded bilingual semantic verification.
# If omitted or unavailable, Tulya automatically falls back to
# deterministic fact verification (zero service interruptions).
# ---------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Google Gemini API Key (Get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Only needed if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

